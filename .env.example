# Copia este archivo a .env.local (Next.js) y a .dev.vars (wrangler).
# Con Supabase local, los valores salen de `pnpm supabase status -o env`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Claves de prueba oficiales de Turnstile (siempre pasan). Sustituir en producción.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Sin clave, los correos se guardan en la tabla `mensaje` y se muestran en consola.
RESEND_API_KEY=
EMAIL_FROM="Arrocería Yerga <reservas@example.com>"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=cambia-esto-por-un-valor-largo-y-aleatorio
