{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/es",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/disponibilidad",
      "destination": "/api/disponibilidad.json"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}